# Google Gemini API key for the morning message and podcast features.
# Free tier: https://aistudio.google.com/app/apikey (no credit card required)
#
# WARNING: Vite inlines VITE_ prefixed env vars into the production bundle.
# This means anyone who opens DevTools on the deployed app can read the key.
# Use this only for local development / personal use. For production,
# proxy the request through a backend you control.
VITE_GEMINI_API_KEY=AIza...
